{% extends 'base.html.twig' %}
{% block title %}Choose a new password{% endblock %}
{% block content %}
<h1>DragonStar RPG</h1>
{% if done %}
  <h2>Password changed</h2>
  <p>You can log in with your new password now.</p>
  <p><a href="login.php">Log in</a></p>
{% elseif not valid %}
  <h2>That link didn't work</h2>
  <p>{{ problem ?: "It may have expired, or already been used." }}</p>
  <p><a href="forgot_password.php">Ask for a new reset link</a></p>
{% else %}
  <h2>Choose a new password for {{ username }}</h2>
  {% if problem %}<p class="problem">{{ problem }}</p>{% endif %}
  <form method="post" action="reset_password.php">
    {{ csrf_field() }}
    <input type="hidden" name="token" value="{{ token }}">
    <table>
      <tr><td><label for="password">New password</label></td><td><input id="password" type="password" name="password" autocomplete="new-password" required></td></tr>
      <tr><td></td><td class="note">At least {{ min_password_length }} characters</td></tr>
      <tr><td><label for="password2">Again</label></td><td><input id="password2" type="password" name="password2" autocomplete="new-password" required></td></tr>
    </table>
    <p><button type="submit">Change password</button></p>
  </form>
{% endif %}
{% endblock %}
