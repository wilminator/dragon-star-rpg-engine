{# Shared by "resend confirmation" and "forgot password": both ask only
   for an email address and always answer the same way. #}
{% extends 'base.html.twig' %}
{% block title %}{{ heading }}{% endblock %}
{% block head %}{{ include('account/_bot_check_head.html.twig') }}{% endblock %}
{% block content %}
<h1>DragonStar RPG</h1>
<h2>{{ heading }}</h2>
{% if done %}
  <p>{{ done_message }}</p>
  <p><a href="login.php">Log in</a></p>
{% else %}
  {% if problem %}<p class="problem">{{ problem }}</p>{% endif %}
  <p>{{ explanation }}</p>
  <form method="post" action="{{ action }}">
    {{ csrf_field() }}
    <label for="email">Email</label> <input id="email" type="email" name="email" value="{{ email }}" autocomplete="email" required>
    {{ include('account/_bot_check.html.twig') }}
    <p><button type="submit">Send</button></p>
  </form>
  {% if code_form is defined %}
    <h3>Or use your authenticator app</h3>
    <p>If your account uses two-factor sign-in, a code from the app (or a recovery code) takes you straight to choosing a new password.</p>
    {% if code_form.problem %}<p class="problem">{{ code_form.problem }}</p>{% endif %}
    <form method="post" action="{{ action }}">
      {{ csrf_field() }}<input type="hidden" name="with" value="code">
      <table>
        <tr><td><label for="who">Username or email</label></td><td><input id="who" name="who" value="{{ code_form.who }}" autocomplete="username" required></td></tr>
        <tr><td><label for="code">Code</label></td><td><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required></td></tr>
      </table>
      <p><button type="submit">Continue</button></p>
    </form>
  {% endif %}
  <p><a href="login.php">Back to log in</a></p>
{% endif %}
{% endblock %}
